# Archivo de ejemplo para sobrescribir configuraciones en desarrollo
# Copiar a docker-compose.override.yml y personalizar según necesidades

version: '3.8'

services:
  backend:
    environment:
      # Sobrescribir variables de entorno para desarrollo
      SPRING_JPA_SHOW_SQL: "true"
      SPRING_PROFILES_ACTIVE: dev
    volumes:
      # Montar código fuente para hot-reload (requiere configuración adicional)
      # - ./75320-backend/src:/app/src:ro

  frontend:
    volumes:
      # Montar código fuente para hot-reload (requiere configuración adicional)
      # - ./75320-frontend/src:/app/src:ro

